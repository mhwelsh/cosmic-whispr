# cosmic-whispr API key.
#
# Copy to ~/.config/cosmic-whispr/.env and chmod 600.
# COSMIC_WHISPR_API_KEY is checked first, then OPENAI_API_KEY.

# A 1Password secret reference, resolved with the `op` CLI at dictation time:
OPENAI_API_KEY="op://Private/OpenAI/credential"

# ...or the key itself:
#OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
